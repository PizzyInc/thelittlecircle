{
  "manifest_version": 3,
  "name": "The Little Circle",
  "version": "0.1.1",
  "description": "Your AI-detection companion — floating on every page.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "The Little Circle"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.tsx"],
      "run_at": "document_end",
      "all_frames": false,
      "exclude_matches": [
        "https://thelittlecircle.com/*",
        "https://www.thelittlecircle.com/*",
        "https://admin.thelittlecircle.com/*",
        "http://localhost:3000/*",
        "http://localhost:3001/*"
      ]
    },
    {
      "matches": [
        "https://thelittlecircle.com/*",
        "https://www.thelittlecircle.com/*",
        "http://localhost:3000/*",
        "http://localhost:3001/*"
      ],
      "js": ["src/bridge.ts"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
